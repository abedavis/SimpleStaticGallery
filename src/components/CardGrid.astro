---
import { Image } from 'astro:assets';
import { countPages, type GalleryItem } from '../lib/gallery';
import { withBase } from '../lib/url';

interface Props {
  items: GalleryItem[];
}
const { items } = Astro.props;

const fmtDate = (d: Date) =>
  d.toLocaleDateString('en-US', { dateStyle: 'medium', timeZone: 'UTC' });

const cards = items.map((item) => {
  if (item.kind === 'section') {
    const s = item.section;
    const n = countPages(s);
    return {
      href: withBase(`/${s.path}/`),
      title: s.title,
      description: s.description,
      thumbnail: s.thumbnail,
      isSection: true,
      meta: `${n} page${n === 1 ? '' : 's'}`,
    };
  }
  const { data } = item.entry;
  return {
    href: withBase(`/${item.entry.id}/`),
    title: data.title,
    description: data.description,
    thumbnail: data.thumbnail,
    isSection: false,
    meta: [data.author, data.date && fmtDate(data.date)].filter(Boolean).join(' · '),
  };
});
---
<ul class="cards">
  {cards.map((c) => (
    <li class:list={['card', { section: c.isSection }]}>
      <a href={c.href}>
        {c.thumbnail ? (
          <Image src={c.thumbnail} alt="" width={640} class="thumb" />
        ) : (
          c.isSection && <div class="thumb placeholder" aria-hidden="true">📁</div>
        )}
        <div class="body">
          {c.isSection && <span class="badge">Collection</span>}
          <h2>{c.title}</h2>
          {c.description && <p class="desc">{c.description}</p>}
          {c.meta && <p class="meta">{c.meta}</p>}
        </div>
      </a>
    </li>
  ))}
</ul>

<style>
  .cards {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 1rem;
  }
  .card a {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 8px;
    overflow: hidden;
    color: inherit;
    text-decoration: none;
    transition: border-color 0.15s;
  }
  .card.section a { border-width: 2px; }
  .card a:hover { border-color: var(--accent); }
  .thumb { width: 100%; aspect-ratio: 16 / 9; object-fit: cover; display: block; }
  .placeholder {
    display: grid;
    place-items: center;
    font-size: 3rem;
    background: var(--border);
  }
  .body { padding: 0.9rem 1rem; }
  .badge {
    display: inline-block;
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--muted);
    margin-bottom: 0.2rem;
  }
  h2 { margin: 0 0 0.3rem; font-size: 1.15rem; color: var(--accent); }
  .desc { margin: 0; }
  .meta { margin: 0.5rem 0 0; color: var(--muted); font-size: 0.85rem; }
</style>
