---
import { withBase } from '../lib/url';
interface Props {
  title: string;
  description?: string;
}
const { title, description } = Astro.props;
const siteTitle = 'Simple Static Gallery';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    {description && <meta name="description" content={description} />}
    <title>{title === siteTitle ? title : `${title} | ${siteTitle}`}</title>
  </head>
  <body>
    <header class="site-header">
      <a href={withBase('/')}>{siteTitle}</a>
    </header>
    <main>
      <slot />
    </main>
  </body>
</html>

<style is:global>
  :root {
    --fg: #1d1d1f;
    --muted: #5f6368;
    --bg: #fafafa;
    --card: #fff;
    --border: #e2e2e2;
    --accent: #b31b1b;
    color-scheme: light dark;
    font-family: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
    line-height: 1.6;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --fg: #e8e8e8;
      --muted: #a0a0a0;
      --bg: #161616;
      --card: #202020;
      --border: #333;
      --accent: #ff6b6b;
    }
  }
  * { box-sizing: border-box; }
  body { margin: 0; background: var(--bg); color: var(--fg); }
  main { max-width: 900px; margin: 0 auto; padding: 1.5rem 1.25rem 4rem; }
  a { color: var(--accent); }
  img, video { max-width: 100%; height: auto; }
  pre { overflow-x: auto; padding: 1rem; border-radius: 6px; }
  table { border-collapse: collapse; width: 100%; display: block; overflow-x: auto; font-size: 0.95rem; }
  th, td { border: 1px solid var(--border); padding: 0.4rem 0.6rem; text-align: left; vertical-align: top; }
  th { background: var(--card); }
  blockquote {
    margin: 1.5rem 0;
    padding: 0.75rem 1rem;
    background: var(--card);
    border: 1px solid var(--border);
    border-left: 4px solid var(--accent);
    border-radius: 6px;
  }
  blockquote > :first-child { margin-top: 0; }
  blockquote > :last-child { margin-bottom: 0; }
  .site-header { border-bottom: 1px solid var(--border); padding: 0.75rem 1.25rem; }
  .site-header a { font-weight: 600; text-decoration: none; color: var(--fg); }
  figure.media { margin: 1.5rem 0; }
  figure.media video { display: block; width: 100%; border-radius: 6px; background: #000; }
  figcaption { color: var(--muted); font-size: 0.9rem; margin-top: 0.4rem; }
</style>
